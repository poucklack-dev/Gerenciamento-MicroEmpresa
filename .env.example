# =========================
# App / Ambiente
# =========================
# development | production | testing
ENV=development

# Em produção é obrigatório (o app não inicia sem).
# Em dev/test pode ser qualquer valor (ou deixar vazio para usar o default do código).
SECRET_KEY=dev-secret-key-change-me

# Ative apenas quando precisar (rotas /debug_user e /api/diag/*)
ENABLE_DEBUG_ROUTES=0

# (Opcional) limite global de request (bytes). Ex: 50MB = 52428800
MAX_CONTENT_LENGTH=52428800

# =========================
# Banco (PostgreSQL)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patagonia
DB_USER=patagonia
DB_PASS=patagonia

# (Opcional) defina apenas se precisar (ex: require). Se vazio, não envia sslmode no psycopg2.
DB_SSLMODE=
DB_CONNECT_TIMEOUT=10

# =========================
# Sessão (opcional Redis)
# =========================
# Ex: redis://:senha@host:6379/0
REDIS_URL=

# Limites globais de requisição (sintaxe do Flask-Limiter)
RATELIMIT_DEFAULT=200 per day; 50 per hour

# =========================
# Storage (Uploads)
# =========================
# local | gcs
STORAGE_DRIVER=local

# LOCAL (quando STORAGE_DRIVER=local)
LOCAL_STORAGE_PATH=./uploads

# GCS (quando STORAGE_DRIVER=gcs)
GCS_BUCKET=your-gcs-bucket-name
UPLOADS_PREFIX=uploads
# Para rodar local com GCS, use credenciais via GOOGLE_APPLICATION_CREDENTIALS=/caminho/sa.json

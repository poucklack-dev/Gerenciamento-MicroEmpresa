# =========================
# App / Ambiente
# =========================
# development | production | testing
ENV=development

# Em produção é obrigatório (o app não inicia sem).
# Em dev/test pode ser qualquer valor (ou deixar vazio para usar o default do código).
SECRET_KEY=change-me-with-a-random-secret

# Ative apenas quando precisar das rotas locais de depuração.
ENABLE_DEBUG_ROUTES=0

# (Opcional) habilita o recarregamento automático em desenvolvimento.
FLASK_DEBUG=0

# (Opcional) limite global de request (bytes). Ex: 10MB = 10485760
MAX_CONTENT_LENGTH=10485760

# =========================
# Banco (PostgreSQL)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patagonia
DB_USER=patagonia
DB_PASS=change-me

DB_CONNECT_TIMEOUT=10

# Limites globais de requisição (sintaxe do Flask-Limiter)
RATELIMIT_DEFAULT=200 per day; 50 per hour

# =========================
# Storage (Uploads)
# =========================
LOCAL_STORAGE_PATH=./uploads
